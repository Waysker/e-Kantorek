# Copy to /etc/ekantorek/forum-sync.env, chmod 600, owner root (docker --env-file and systemd read it as root).
ORAGH_FORUM_USERNAME=
ORAGH_FORUM_PASSWORD=
# Self-hosted Supabase URL and its SERVICE_ROLE key (never the Cloud values).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ORAGH_SNAPSHOT_KEY=forum
ORAGH_INSTRUMENT_OVERRIDES_KEY=forum
# Optional: healthchecks.io-style ping URL; alert when pings stop (e.g. period 20m, grace 40m).
HC_PING_URL=
